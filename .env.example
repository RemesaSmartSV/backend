# RemesaSmartSV Backend - plantilla de variables de entorno
#
# Copia este archivo a .env y completa los valores reales.
# .env esta en .gitignore: nunca se sube a git.
# docker-compose.yml lee .env desde esta misma carpeta.

ASPNETCORE_ENVIRONMENT=Development

# Clave de firma JWT (HMAC-SHA256). Usa una distinta por entorno y
# al menos 32 bytes. El backend no arranca si esta variable falta.
JWT_KEY=CAMBIAR_POR_UNA_CLAVE_ALEATORIA_DE_AL_MENOS_32_BYTES

# Contrasena de PostgreSQL. Debe coincidir con el volumen de datos existente.
POSTGRES_PASSWORD=CAMBIAR_POR_UNA_CLAVE_SEGURA

# Origenes permitidos por CORS en produccion (separados por coma).
# En desarrollo el predeterminado es http://localhost:5173.
CORS_ORIGINS_PROD=http://localhost:5173

# --- Solo para arranque local sin docker-compose (dotnet run) ---
# docker-compose.yml inyecta estas variables por su cuenta.
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=RemesaSmartDB;Username=postgres;Password=
# Jwt__Issuer=RemesaSmartSV
# Jwt__Audience=RemesaSmartSVClient
