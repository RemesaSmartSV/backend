# RemesaSmart SV — variables de PRODUCCIÓN
#
# Copia este archivo a .env (en la carpeta backend/) y completa los valores.
# .env está en .gitignore: nunca se sube a git.
#
#   cp .env.prod.example .env
#   nano .env

# --- Dominio y URL pública (sin barra final) ---
# DOMAIN: solo el host, sin https://  (lo usa Caddy para el certificado)
DOMAIN=app.tudominio.com
# APP_URL: URL completa con esquema, SIN barra final (la usan los enlaces de correo)
APP_URL=https://app.tudominio.com

# --- Secretos ---
# Clave de firma JWT: genera una nueva y larga. Ejemplo:
#   openssl rand -base64 48
JWT_KEY=CAMBIAR_POR_UNA_CLAVE_ALEATORIA_DE_AL_MENOS_32_BYTES

# Contraseña de PostgreSQL. Usa SOLO letras y números (sin ; $ " ' ni espacios),
# porque se inyecta en la cadena de conexión del backend.
POSTGRES_PASSWORD=CAMBIAR_POR_CLAVE_ALFANUMERICA_SEGURA

# --- Google Sign-In (mismo Client ID del proyecto) ---
# Recuerda agregar https://app.tudominio.com en "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# --- Correo SMTP ---
# Gmail con contraseña de aplicación (SMTP_HOST/SMTP_PORT por defecto).
# En instancias GRATUITAS de Render los puertos 25/465/587 están bloqueados:
# usar un proveedor con puerto 2525 (SMTP2GO, Mailgun, Elastic Email...).
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Remitente visible en los correos (defecto: SMTP_USER).
SMTP_FROM=

# --- Administradores globales de tips (correos separados por coma) ---
TIPS_ADMIN_EMAILS=

# --- IA de consejos (Groq, tier free). Vacío = IA desactivada (usa tips de la BD) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
